---
import BaseLayout from '../layouts/BaseLayout.astro';

/*
 * Beispielbilder (CC-Platzhalter, Nachweis im Impressum) — werden durch
 * echte Sammlungsfotos ersetzt, sobald sie vorliegen.
 *
 * TODO (vorgemerkt, noch nicht umsetzen — siehe docs/OFFENE-AUFGABEN.md):
 * 1) Lehrvideos/Sonderformate: Das Museum soll perspektivisch als interaktive
 *    Ausstellung verstanden werden, in der auch aktive Beiträge und andere
 *    Medien Platz finden. Es liegen noch keine Inhalte/Skripte vor.
 * 2) Das Museum ist eine eigenständige, zweite Sammlung (Mittel- und
 *    Großstufen) innerhalb der Sammlungsverwaltung und braucht dort
 *    perspektivisch einen eigenen Einstiegspunkt (noch nicht spezifiziert).
 */
const einblicke = [
  { bild: '/bilder/wulfenit.jpg', titel: 'Wulfenit auf Baryt' },
  { bild: '/bilder/fluorit.jpg', titel: 'Fluorit auf Quarz' },
  { bild: '/bilder/pyromorphit.jpg', titel: 'Pyromorphit' },
  { bild: '/bilder/calcit.jpg', titel: 'Calcit mit Aurichalcit' },
  { bild: '/bilder/baryt.jpg', titel: 'Baryt' },
  { bild: '/bilder/epidot.jpg', titel: 'Epidot' },
];
---
<BaseLayout
  title="Virtuelles Museum"
  pageTitle="Virtuelles Museum"
  kicker="Museum & Bildung"
  lead="Ein virtueller Rundgang zeigt ausgewählte Highlights der Lithothek – von seltenen Mineralarten bis zu besonderen Fundstücken."
>
  <p>
    Die Lithothek arbeitet mit Museen zusammen und integriert Sammlungen auch in die
    eigenen Räume. Das Konzept für die virtuelle Ausstellung entsteht derzeit
    (siehe Projektplan, Bereich „Virtuelles Museum").
  </p>

  <h2>Einblicke in die Sammlung</h2>
  <p class="demo-note">
    <strong>Beispielansicht:</strong> Die gezeigten Fotos sind frei lizenzierte
    Platzhalter (Bildnachweis im Impressum) und werden durch eigene Sammlungsfotos ersetzt.
  </p>
  <div class="gallery">
    {einblicke.map((e) => (
      <figure>
        <img src={e.bild} alt={e.titel} loading="lazy" />
        <figcaption>{e.titel}</figcaption>
      </figure>
    ))}
  </div>
</BaseLayout>
