---
import BaseLayout from '../layouts/BaseLayout.astro';
import CrystalMotif from '../components/brand/CrystalMotif.astro';
import { getCollection } from 'astro:content';

const projekte = (await getCollection('projekte')).sort((a, b) => a.data.reihenfolge - b.data.reihenfolge);
const news = (await getCollection('news')).sort((a, b) => b.data.datum.valueOf() - a.data.datum.valueOf()).slice(0, 4);

/*
 * Merkmalsleiste unter dem Hero (Layout-Vorbild: Design-Zielbild 08/2026).
 * Icons: lineare Zeichnungen, 1.5–2 px Strich (CI Kapitel 06).
 */
const merkmale = [
  {
    titel: 'Einzigartige Sammlung',
    text: 'Tausende Mineralstufen aus aller Welt – im Mikromaßstab und mit großer Vielfalt.',
    icon: 'kristall',
  },
  {
    titel: 'Forschung & Dokumentation',
    text: 'Wir dokumentieren, untersuchen und machen Wissen über Mineralien zugänglich.',
    icon: 'lupe',
  },
  {
    titel: 'Museum & Bildung',
    text: 'Ausstellungen, Veranstaltungen und Führungen für alle Altersgruppen.',
    icon: 'museum',
  },
  {
    titel: 'Gemeinschaft',
    text: 'Ein Netzwerk von Sammlern, Forschern und Freunden der Mineralogie.',
    icon: 'gemeinschaft',
  },
];
---
<BaseLayout title="Start" fullWidth>
  <!-- Bühne (CI Website-Anwendung 01): ein Motiv, eine Aussage, ein primärer CTA -->
  <section class="hero on-dark hero--stage">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="kicker">Der Mikromineralogie ein Gesicht geben</p>
        <h1>Willkommen in der Lithothek</h1>
        <p class="lead">
          Ein Archiv der Erdgeschichte im Mikromaßstab. Wir bewahren, dokumentieren und
          vermitteln Objekte, Fundorte und das Wissen der Menschen, die sich mit ihnen
          beschäftigen – als gemeinnützige Förderung der Volksbildung in Mineralogie,
          Lagerstättenkunde, Geologie, Paläontologie und Bergbau.
        </p>
        <div class="hero-actions">
          <a class="button" href="/lithothek-online/">Unsere Sammlung entdecken</a>
          <a class="button-ghost" href="/ueber-uns/">Über uns</a>
        </div>
      </div>
      <div class="hero-visual">
        <CrystalMotif variant="hero" />
      </div>
    </div>
  </section>

  <!-- Merkmalsleiste -->
  <section class="features wrap" aria-label="Was die Lithothek ausmacht">
    {merkmale.map((m) => (
      <div class="feature">
        <span class="feature-icon" aria-hidden="true">
          {m.icon === 'kristall' && (
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round" stroke-linecap="round">
              <path d="M24 6 L14 18 L24 42 L34 18 Z" />
              <path d="M14 18 L24 22 L34 18" />
              <path d="M24 22 L24 42" />
              <path d="M19 12 L24 22 L29 12" />
            </svg>
          )}
          {m.icon === 'lupe' && (
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round" stroke-linecap="round">
              <circle cx="21" cy="21" r="11" />
              <path d="M29 29 L40 40" />
              <path d="M21 15.5 L17 21 L21 26.5 L25 21 Z" />
            </svg>
          )}
          {m.icon === 'museum' && (
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round" stroke-linecap="round">
              <path d="M8 40 L40 40" />
              <path d="M10 36 L38 36" />
              <path d="M12 20 L12 36 M19 20 L19 36 M29 20 L29 36 M36 20 L36 36" />
              <path d="M8 20 L40 20 L24 8 Z" />
            </svg>
          )}
          {m.icon === 'gemeinschaft' && (
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round" stroke-linecap="round">
              <circle cx="24" cy="17" r="5" />
              <path d="M15 38 C15 31 20 28 24 28 C28 28 33 31 33 38" />
              <circle cx="11" cy="20" r="4" />
              <path d="M4 37 C4 31.5 7.5 29 11 29" />
              <circle cx="37" cy="20" r="4" />
              <path d="M44 37 C44 31.5 40.5 29 37 29" />
            </svg>
          )}
        </span>
        <h3 class="feature-title">{m.titel}</h3>
        <p class="feature-text">{m.text}</p>
      </div>
    ))}
  </section>

  <div class="wrap">
    <!-- Projekte -->
    <section>
      <h2>Unsere Projekte</h2>
      <div class="card-grid card-grid--media">
        {projekte.map((p, i) => (
          <article class="card card--media">
            <div class="card-media">
              <CrystalMotif variant="card" seed={i + 1} />
            </div>
            <div class="card-body">
              <h3>{p.data.titel}</h3>
              <p>{p.data.kurzbeschreibung}</p>
              <a href={p.data.externerLink ?? '/projekte/'} {...(p.data.externerLink ? { target: '_blank', rel: 'noopener' } : {})}>
                Mehr erfahren →
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Aktuelles -->
    <section>
      <div class="section-head">
        <h2>Aktuelles</h2>
        <a class="section-link" href="/news/">Alle Nachrichten →</a>
      </div>
      <div class="card-grid card-grid--media">
        {news.map((n, i) => (
          <article class="card card--media">
            <div class="card-media card-media--news">
              <CrystalMotif variant="card" seed={i + 2} />
            </div>
            <div class="card-body">
              <p class="meta">{n.data.datum.toLocaleDateString('de-DE', { day: '2-digit', month: 'long', year: 'numeric' })}</p>
              <h3 class="card-title-s"><a class="card-title-link" href={`/news/${n.id}/`}>{n.data.titel}</a></h3>
            </div>
          </article>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
