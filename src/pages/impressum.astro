---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Impressum">
  <h1>Impressum</h1>
  <p><em>Platzhalter — bitte mit den tatsächlichen Pflichtangaben nach § 5 TMG ergänzen.</em></p>
  <h2>Angaben gemäß § 5 TMG</h2>
  <p>
    Geolitho Stiftung gGmbH<br />
    [Straße, Hausnummer]<br />
    [PLZ, Ort]
  </p>
  <h2>Vertreten durch</h2>
  <p>[Name der Geschäftsführung]</p>
  <h2>Registereintrag</h2>
  <p>
    Eintragung im Handelsregister.<br />
    Registergericht: [Amtsgericht]<br />
    Registernummer: [HRB-Nummer]
  </p>
  <h2>Kontakt</h2>
  <p>
    Telefon: [Telefonnummer]<br />
    E-Mail: [E-Mail-Adresse]
  </p>
  <h2>Gemeinnützigkeit</h2>
  <p>
    [Hinweis zur Anerkennung als gemeinnützige Körperschaft, zuständiges Finanzamt,
    Steuernummer / Freistellungsbescheid]
  </p>
</BaseLayout>
