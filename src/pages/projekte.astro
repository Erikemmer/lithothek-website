---
import BaseLayout from '../layouts/BaseLayout.astro';
import CrystalMotif from '../components/brand/CrystalMotif.astro';
import { getCollection } from 'astro:content';

const projekte = (await getCollection('projekte')).sort((a, b) => a.data.reihenfolge - b.data.reihenfolge);
---
<BaseLayout
  title="Projekte"
  pageTitle="Unsere Projekte"
  kicker="Was wir aufbauen"
  lead="Zwei Vorhaben tragen die Arbeit der Lithothek: die physische Sammlung der Münchner Micromounter und ihr digitales Gegenstück. Perspektivisch wächst dieser Bereich um alles, was im Sinne unseres gemeinnützigen Zwecks mit Schulen, Museen und anderen Trägern der Volksbildung entsteht."
>
  <div class="card-grid card-grid--media card-grid--two">
    {projekte.map((p, i) => (
      <article class="card card--media">
        <div class="card-media">
          {p.data.bild
            ? <img src={p.data.bild} alt={p.data.titel} loading="lazy" />
            : <CrystalMotif variant="card" seed={i + 1} />}
        </div>
        <div class="card-body">
          <h3>{p.data.titel}</h3>
          <p>{p.data.kurzbeschreibung}</p>
          {p.data.externerLink
            ? <a href={p.data.externerLink} target="_blank" rel="noopener">Mehr erfahren →</a>
            : <a href="/lithothek-online/">Zur Sammlung →</a>}
        </div>
      </article>
    ))}
  </div>
</BaseLayout>
