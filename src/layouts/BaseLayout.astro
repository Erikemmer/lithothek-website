---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Selbst gehostete CI-Schriften (Fontsource) — kein externes Font-CDN,
// damit keine personenbezogenen Daten an Dritte fließen (DSGVO).
import '@fontsource-variable/inter';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/cormorant-garamond/400.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** true: Seite steuert ihre Breite selbst (z. B. Startseite mit vollflächigem Hero) */
  fullWidth?: boolean;
}

const {
  title,
  description = 'Lithothek gGmbH – Sammlung, Museum und Projekte rund um Mineralien.',
  fullWidth = false,
} = Astro.props;

/*
 * Brotkrumen-Navigation (Layout-Vorbild: Design-Zielbild 08/2026).
 * Wird automatisch aus dem Pfad erzeugt; die Startseite zeigt keine.
 */
const labels: Record<string, string> = {
  'ueber-uns': 'Über uns',
  'lithothek-online': 'Sammlung',
  museum: 'Museum',
  projekte: 'Projekte',
  sammler: 'Sammler',
  news: 'News',
  impressum: 'Impressum',
  datenschutz: 'Datenschutz',
};
const segments = Astro.url.pathname.split('/').filter(Boolean);
const crumbs = segments.map((seg, i) => ({
  label:
    labels[seg] ??
    decodeURIComponent(seg)
      .replace(/-/g, ' ')
      .replace(/\b\p{L}/gu, (c) => c.toUpperCase()),
  href: '/' + segments.slice(0, i + 1).join('/') + '/',
}));
const showCrumbs = !fullWidth && crumbs.length > 0;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} · Lithothek gGmbH</title>
  </head>
  <body>
    <Header />
    <main class={fullWidth ? undefined : 'wrap'}>
      {showCrumbs && (
        <nav class="crumbs" aria-label="Brotkrumen">
          <ol>
            <li><a href="/">Startseite</a></li>
            {crumbs.map((c, i) => (
              <li>
                {i < crumbs.length - 1 ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
              </li>
            ))}
          </ol>
        </nav>
      )}
      <slot />
    </main>
    <Footer />
  </body>
</html>
