---
/*
 * Typografische Wortmarke „DIE / LITHOTHEK" (CI Kapitel 02, Muster 4
 * „Minimal & Strukturiert"): beide Zeilen in der Serifenschrift,
 * „DIE" stark gesperrt und zentriert über „LITHOTHEK".
 * Kein grafisches Signet — Wirkung entsteht aus Typografie und Proportion.
 * Farbe kommt vom Kontext: Gold auf dunklen Flächen, Tinte auf hellen.
 *
 * Varianten:
 *  - default: „DIE" gesperrt über „LITHOTHEK", optional mit Subline
 *  - short:   nur „LITHOTHEK" (für sehr kleine Flächen)
 */
interface Props {
  variant?: 'default' | 'short';
  subline?: boolean;
}
const { variant = 'default', subline = false } = Astro.props;
---
<span class="wordmark" data-variant={variant}>
  {variant === 'default' && <span class="wordmark-die">DIE</span>}
  <span class="wordmark-name">LITHOTHEK</span>
  {subline && variant === 'default' && (
    <span class="wordmark-subline">der Münchner Micromounter</span>
  )}
</span>

<style>
  .wordmark {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    line-height: 1.1;
    text-decoration: none;
    text-align: center;
  }
  .wordmark-die {
    font-family: var(--font-serif);
    font-size: 0.52em;
    font-weight: 600;
    letter-spacing: 0.62em;
    /* Sperrung optisch ausgleichen (letzter Buchstabe trägt auch Abstand) */
    margin-right: -0.62em;
  }
  .wordmark-name {
    font-family: var(--font-serif);
    font-weight: 600;
    letter-spacing: 0.14em;
    margin-right: -0.14em;
  }
  .wordmark-subline {
    font-family: var(--font-sans);
    font-size: 0.38em;
    font-weight: 400;
    letter-spacing: 0.08em;
    opacity: 0.85;
    margin-top: 0.35em;
  }
</style>
