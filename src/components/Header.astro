---
import Wordmark from './brand/Wordmark.astro';

/*
 * Navigation gemäß Corporate Identity v1.1 (Website-Anwendung 01):
 * Wortmarke (führt zur Startseite) · Über uns · Sammlung · Museum ·
 * Projekte · Sammler · News — plus externer Mineralienatlas-Link
 * (Entscheidungsprotokoll: nur externer Link, kein eigenes Projekt).
 * Die URLs bleiben unverändert, nur die Beschriftungen folgen der CI.
 */
const nav = [
  { href: '/ueber-uns/', label: 'Über uns' },
  { href: '/lithothek-online/', label: 'Sammlung' },
  { href: '/museum/', label: 'Museum' },
  { href: '/projekte/', label: 'Projekte' },
  { href: '/sammler/', label: 'Sammler' },
  { href: '/news/', label: 'News' },
];
---
<header class="site-header">
  <div class="wrap" style="display:flex; justify-content:space-between; align-items:center; gap:1rem; flex-wrap:wrap;">
    <a href="/" class="brand-link" aria-label="Zur Startseite der Lithothek">
      <Wordmark />
    </a>
    <nav class="main-nav" aria-label="Hauptnavigation">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <a
      href="https://www.mineralienatlas.de/"
      target="_blank"
      rel="noopener"
      class="external-link"
    >
      Mineralienatlas ↗
    </a>
  </div>
</header>

<style>
  .brand-link {
    /* CI-Anwendungsbeispiel: Wortmarke in Gold auf dunkler Fläche */
    text-decoration: none;
    color: var(--color-accent);
    font-size: 1.35rem;
  }
  .brand-link:hover { color: var(--ivory); }
</style>
