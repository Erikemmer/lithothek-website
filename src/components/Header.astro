---
const nav = [
  { href: '/', label: 'Start' },
  { href: '/ueber-uns/', label: 'Über uns' },
  { href: '/lithothek-online/', label: 'Die Lithothek Online' },
  { href: '/museum/', label: 'Virtuelles Museum' },
  { href: '/projekte/', label: 'Projekte' },
  { href: '/sammler/', label: 'Sammler-Steckbriefe' },
  { href: '/news/', label: 'Neuigkeiten' },
];
---
<header class="site-header">
  <div class="wrap" style="display:flex; justify-content:space-between; align-items:center; gap:1rem; flex-wrap:wrap;">
    <a href="/" style="font-weight:bold; font-size:1.2rem; text-decoration:none; color:var(--color-text);">
      Lithothek gGmbH
    </a>
    <nav class="main-nav">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <a
      href="https://www.mineralienatlas.de/"
      target="_blank"
      rel="noopener"
      class="external-link"
    >
      Mineralienatlas ↗
    </a>
  </div>
</header>
